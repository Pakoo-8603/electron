{
  "name": "electron-hikvision-gateway",
  "version": "0.1.0",
  "description": "Electron gateway local para Hikvision ISAPI",
  "main": "dist/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on tcp:5173 file:dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "digest-fetch": "^3.1.1",
    "electron-store": "^10.1.0",
    "fast-xml-parser": "^4.5.0",
    "keytar": "^7.9.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "wait-on": "^8.0.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.hikvision.gateway",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}